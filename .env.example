# ---- 인증 (둘 중 하나) ----
# 1) 구글 로그인 (운영 권장): Google Cloud Console OAuth 클라이언트 ID (비밀 아님)
GOOGLE_CLIENT_ID=
# 로그인 허용 이메일 (쉼표 구분). 비우면 구글 계정 누구나 가입 가능
ALLOWED_EMAILS=
# 2) PIN (로컬 개발용, GOOGLE_CLIENT_ID 없을 때만 사용)
APP_PIN=1234
# 토큰 서명용 비밀값 (아무 긴 문자열)
APP_SECRET=change-me-to-a-long-random-string
# SQLite 파일 경로
DB_PATH=./data/ledger.sqlite
PORT=3000
# Turso (설정하면 원격 DB 사용, 없으면 DB_PATH 로컬 파일)
TURSO_DATABASE_URL=libsql://your-db-name-xxx.turso.io
TURSO_AUTH_TOKEN=eyJ...

# ---- 캡처 가져오기 (선택) ----
# Google AI Studio 에서 발급 (무료 티어). 없으면 기능 숨김
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
# 이 기능을 쓸 수 있는 계정 (쉼표 구분). 비우면 로그인한 모두
IMPORT_ALLOWED_EMAILS=
# 사용 요청 알림 메일 (Resend 무료 티어). 둘 다 있어야 발송
RESEND_API_KEY=
OWNER_EMAIL=
